# Root .gitignore for consolidated project

# Python (Backend)
backend/venv/
backend/.venv/
**/__pycache__/
**/*.py[cod]
**/*$py.class
backend/*.so
backend/dist/
backend/build/
backend/*.egg-info/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# Node.js (Frontend)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*

# Secrets & tokens
.env
.env.local
.env.*.local
**/.env
**/new_token.txt
**/*token*.txt

# Runtime / generated state
*.log
backend/app/data/
backend/app/ma_crossover_state.json
**/*.jsonl

# General
.DS_Store
*.pem
.idea/
.vscode/
*.swp
*.swo
