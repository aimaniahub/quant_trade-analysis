# ==============================================================================
# OptionGreek - Production Environment Configuration
# ==============================================================================

# ── Fyers API Credentials (Required) ──────────────────────────────────────────
# Get these from your Fyers API dashboard: https://myapi.fyers.in
FYERS_APP_ID=
FYERS_SECRET_KEY=
# In Vercel, set this to: https://<your-project>.vercel.app/api/v1/auth/callback
FYERS_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
# Generated after login or paste existing daily token
FYERS_ACCESS_TOKEN=

# ── Automated Daily Login (Optional - avoids manual OAuth) ───────────────────
FYERS_USER_ID=
FYERS_PIN=
FYERS_TOTP_SECRET=

# ── Persistent Storage / Cache (Upstash Redis) ─────────────────────────────────
# Auto-detected from Vercel Upstash integration:
# - redisupstashfyers_REDIS_URL
# - redisupstashfyers_KV_URL
# - REDIS_URL
# e.g. rediss://default:<password>@improved-kid-205065.upstash.io:6379
REDIS_URL=
REDIS_ENABLED=true

# ── AI Intelligence Engines (Optional) ───────────────────────────────────────
# OpenRouter API Key for AI Option Chain Analyst
OPENROUTER_API_KEY=
# Grok API Key for Market News Sentiment
GROK_API_KEY=
