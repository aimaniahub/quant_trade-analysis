# ── Fyers ──────────────────────────────────────────────────────────
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
FYERS_ACCESS_TOKEN=
FYERS_USER_ID=
FYERS_PIN=
FYERS_TOTP_SECRET=

# ── Optional Grok news ─────────────────────────────────────────────
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# ── MCP trading kill-switch ────────────────────────────────────────
MCP_TRADING_ENABLED=false
MCP_API_KEY=

# ── Redis (required in prod — shared symbol store + jobs) ──────────
# Memory fallback works for a single worker if Redis is down.
# Start: docker compose up -d redis
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=optiongreek
REDIS_JOB_TTL_SECONDS=3600
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CONNECT_TIMEOUT=2.0
REDIS_JOB_PERSIST_INTERVAL=1.5

# Harvest writer (Flow Radar / scheduler)
HARVEST_INTERVAL_SECS=180
HARVEST_OC_STRIKES=14
HARVEST_OC_STRIKES_INDEX=20
HARVEST_HISTORY_15_DAYS=40
HARVEST_HISTORY_D_DAYS=30
HARVEST_OC_TTL_SECS=120
HARVEST_QUOTES_TTL_SECS=15
HARVEST_HISTORY_15_TTL_SECS=900
STALE_SOFT_SECS=90
STALE_HARD_SECS=300
SYMBOL_STORE_TTL_SECS=14400

# ── App ────────────────────────────────────────────────────────────
DEBUG=false
