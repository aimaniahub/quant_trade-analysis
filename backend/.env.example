# ── Fyers ──────────────────────────────────────────────────────────
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
FYERS_ACCESS_TOKEN=
FYERS_USER_ID=
FYERS_PIN=
FYERS_TOTP_SECRET=

# ── Optional Grok news ─────────────────────────────────────────────
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# ── MCP trading kill-switch ────────────────────────────────────────
MCP_TRADING_ENABLED=false
MCP_API_KEY=

# ── Redis (durable scan jobs + L2 market cache) ────────────────────
# Start: docker compose up -d redis
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=optiongreek
REDIS_JOB_TTL_SECONDS=3600
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CONNECT_TIMEOUT=2.0
REDIS_JOB_PERSIST_INTERVAL=1.5

# ── App ────────────────────────────────────────────────────────────
DEBUG=false
